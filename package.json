{
  "name": "memory-ci",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "vitest run",
    "test:starter": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test:e2e": "playwright test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .aws-sam --ignore-pattern .sam-cli",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "infra:validate": "__SAM_CLI_APP_DIR=.sam-cli SAM_CLI_TELEMETRY=0 sam validate --lint --template-file infra/template.yaml",
    "infra:build": "__SAM_CLI_APP_DIR=.sam-cli SAM_CLI_TELEMETRY=0 npm_config_cache=/private/tmp/memory-ci-npm-cache sam build --template-file infra/template.yaml",
    "aws:smoke": "tsx scripts/aws-smoke.ts",
    "cloud:evidence": "tsx scripts/cloud-evidence.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "demo:reset": "tsx scripts/reset-demo.ts",
    "vector:evidence": "tsx scripts/vector-evidence.ts",
    "ccloud:evidence": "tsx scripts/ccloud-evidence.ts",
    "verify": "npm test && npm run test:integration && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1111.0",
    "@aws-sdk/client-eventbridge": "^3.1111.0",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/client-secrets-manager": "^3.1111.0",
    "@aws-sdk/client-sts": "^3.1111.0",
    "@tanstack/react-query": "^5.101.4",
    "drizzle-orm": "0.45.2",
    "jose": "^6.2.8",
    "lucide-react": "^1.31.0",
    "pg": "^8.23.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.51.3",
    "@cloudflare/workers-types": "4.20260702.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "22.19.19",
    "@types/pg": "^8.21.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jsdom": "^30.0.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "vitest": "^4.1.10",
    "wrangler": "4.92.0",
    "yaml": "^2.9.0"
  },
  "type": "module"
}
