# Server-only AWS runtime configuration
DATABASE_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:stash/database
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EVIDENCE_BUCKET=stash-evidence-production
EVENT_BUS_NAME=stash

# Server-only Vercel session boundary
STASH_API_BASE_URL=https://api.trystash.xyz
STASH_BOOTSTRAP_KEY=replace-with-a-server-bootstrap-key
STASH_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
STASH_TRUSTED_SOURCE_KEYS=[]

# The only browser-visible runtime setting
NEXT_PUBLIC_APP_URL=https://trystash.xyz
